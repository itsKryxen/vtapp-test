# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — SERVER ONLY. Never expose to the browser, never commit.
# Used by the admin panel to create club accounts and issue club IDs.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://vtapp.vitap.ac.in
NEXT_PUBLIC_FEST_YEAR=2026

# Demo content (events, clubs, sponsors, team) fills the site automatically
# while Supabase is unconfigured, so a fresh clone looks finished. Once the
# Supabase keys above are set, real data takes over and the demo is unreachable.
# Set this to false to preview the empty "announced soon" states instead.
# NEXT_PUBLIC_SHOW_DEMO_EVENTS=false

# ---- Ticketing ----
# Where buyers are sent to pay. Defaults to the VIT-AP events portal.
NEXT_PUBLIC_PAYMENT_PORTAL=https://events.vitap.ac.in
